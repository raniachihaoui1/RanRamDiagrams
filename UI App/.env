# Copy to .env and adjust. The backend reads this file.

# Branding (placeholder — change anytime)
APP_NAME=RanRam Studio

# ComfyUI integration:
#   auto = use real ComfyUI when it's running, fall back to mock when it's not.
#   mock = always simulated results, no GPU/ComfyUI needed.
#   real = always use ComfyUI at COMFY_URL (errors if it's not running).
COMFY_MODE=auto
COMFY_URL=http://127.0.0.1:8188

# Path to your ComfyUI installation. The app auto-derives LORAS_DIR from it.
COMFY_DIR=C:/Users/Win11/ComfyUI

# Backend server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage & workflows (relative to "UI App/" unless absolute).
STORAGE_DIR=storage
WORKFLOWS_DIR=workflows

# Local LoRA folder — leave empty to auto-derive from COMFY_DIR/models/loras.
LORAS_DIR=

# Frontend -> backend URL (used by Next.js at build/runtime)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
