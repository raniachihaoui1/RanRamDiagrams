# Copy to .env and adjust. The backend reads this file.

# Branding (placeholder — change anytime)
APP_NAME=RanRam Studio

# ComfyUI integration: "mock" runs the full UI with simulated results (no GPU
# needed). Switch to "real" once ComfyUI is running and workflows are mapped.
COMFY_MODE=mock
COMFY_URL=http://127.0.0.1:8188

# Backend server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage & models (relative to "UI App/" unless absolute)
STORAGE_DIR=storage
MODELS_DIR=models
WORKFLOWS_DIR=workflows

# Frontend -> backend URL (used by Next.js at build/runtime)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
