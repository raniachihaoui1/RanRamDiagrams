# Copy to .env and adjust. The backend reads this file.

# Branding (placeholder — change anytime)
APP_NAME=Diagram Studio

# ComfyUI integration:
#   mock = full UI with simulated results, no GPU/ComfyUI needed (default).
#   real = generate via a running ComfyUI at COMFY_URL. The FLUX.2 img2img
#          workflow is already wired (workflows/flux_img2img.json); the Model/LoRA
#          chips are fetched live from ComfyUI. See README "mock → real".
COMFY_MODE=mock
COMFY_URL=http://127.0.0.1:8188

# Backend server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage & workflows (relative to "UI App/" unless absolute).
STORAGE_DIR=storage
WORKFLOWS_DIR=workflows

# Local LoRA folder shown in the dropdown — point this at ComfyUI's models/loras
# folder. Scanned recursively for .safetensors/.ckpt/.pt/etc. and merged with the
# LoRAs ComfyUI reports. Leave empty to list LoRAs from ComfyUI's API only.
# Absolute path, forward slashes, e.g.:
#   LORAS_DIR=E:/ComfyUI/models/loras
LORAS_DIR=

# Frontend -> backend URL (used by Next.js at build/runtime)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
